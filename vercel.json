{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/app-style-:version.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-main-:version.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app-shell-:version.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/limpeza-de-sofa/:path*",
      "destination": "/?servico=cat_limpeza_estofados",
      "permanent": false
    },
    {
      "source": "/higienizacao-de-sofa/:path*",
      "destination": "/?servico=cat_limpeza_estofados",
      "permanent": false
    },
    {
      "source": "/lavagem-de-tapetes/:path*",
      "destination": "/?servico=cat_limpeza_estofados",
      "permanent": false
    },
    {
      "source": "/limpeza-de-colchas/:path*",
      "destination": "/?servico=cat_limpeza_estofados",
      "permanent": false
    },
    {
      "source": "/limpeza-de-estofado/:path*",
      "destination": "/?servico=cat_limpeza_estofados",
      "permanent": false
    },
    {
      "source": "/limpeza-pos-obra/:path*",
      "destination": "/?servico=cat_faxina_pos_obra",
      "permanent": false
    },
    {
      "source": "/tecnico-em-automacao/:path*",
      "destination": "/?servico=cat_automacao_residencial",
      "permanent": false
    },
    {
      "source": "/tecnico-em-informatica/:path*",
      "destination": "/?servico=cat_informatica",
      "permanent": false
    },
    {
      "source": "/diarista/:path*",
      "destination": "/?servico=cat_diarista",
      "permanent": false
    },
    {
      "source": "/faxineira/:path*",
      "destination": "/?servico=cat_diarista",
      "permanent": false
    },
    {
      "source": "/pintor/:path*",
      "destination": "/?servico=cat_pintor",
      "permanent": false
    },
    {
      "source": "/cadastro-profissional",
      "destination": "/#/auth/profissional/cadastro",
      "permanent": false
    },
    {
      "source": "/seja-profissional",
      "destination": "/#/auth/profissional/cadastro",
      "permanent": false
    },
    {
      "source": "/profissionais/cadastro",
      "destination": "/#/auth/profissional/cadastro",
      "permanent": false
    },
    {
      "source": "/download/:path*",
      "destination": "https://play.google.com/store/apps/details?id=br.app.quemfaz",
      "permanent": false
    }
  ]
}
